  "db_name": "SQLite",
  "query": "SELECT a.id            AS \"id!: i64\",\n                  u.display_name  AS \"actor_name!\",\n                  a.entity        AS \"entity!\",\n                  a.entity_id     AS \"entity_id?: i64\",\n                  a.op            AS \"op!\",\n                  a.label         AS \"label!\",\n                  a.created_at    AS \"created_at!\"\n           FROM audit_log a\n           JOIN users u ON u.id = a.actor_user_id\n           WHERE a.family_id = ?\n             AND a.id < ?\n             AND (? IS NULL OR a.entity = ?)\n             AND (? IS NULL OR a.actor_user_id = ?)\n           ORDER BY a.id DESC\n           LIMIT ?",
