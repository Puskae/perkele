  "query": "SELECT r.message_id AS \"message_id!: i64\",\n                  r.user_id    AS \"user_id!: i64\",\n                  r.emoji      AS \"emoji!: String\"\n           FROM message_reactions r\n           JOIN messages m ON m.id = r.message_id\n           WHERE m.family_id = ? AND r.message_id BETWEEN ? AND ?\n           ORDER BY r.id",
